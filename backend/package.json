{
  "name": "data-inova-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.js",
    "test": "vitest",
    "seed": "node scripts/seed.js",
    "db:comments:apply": "psql \"$DATABASE_URL\" -f db/comments.sql",
    "db:docs": "node scripts/generate-db-docs.js",
    "smtp:test": "node scripts/send-test-email.js"
  },
  "dependencies": {
    "@types/stripe": "^8.0.416",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.0",
    "stripe": "^19.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.22",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.10.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "vitest": "^1.3.0"
  }
}
