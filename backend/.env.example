# Backend environment example (copy to backend/.env and adjust)

# Database (Aiven example)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Add SSL flags so the app enforces TLS when connecting to cloud providers
DATABASE_URL=postgres://avnadmin:REDACTED@datainovaconnect-datainovaconnect.b.aivencloud.com:28097/dbdic
DATABASE_SSL=true
# Alternatively (psql): PGSSLMODE=require
# PGSSLMODE=require

# Frontend base URL for redirects and CORS
WEBAPP_BASE_URL=http://localhost:5173

# JWT keys (prefer RS256 in production). For dev, fallback to HS256 secret below.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_SECRET=dev-insecure-secret

