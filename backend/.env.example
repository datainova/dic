# Backend environment example (copy to backend/.env and adjust)

# Database (Aiven example)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Add SSL flags so the app enforces TLS when connecting to cloud providers
DATABASE_URL=postgres://avnadmin:REDACTED@datainovaconnect-datainovaconnect.b.aivencloud.com:28097/dbdic
DATABASE_SSL=true
# Alternatively (psql): PGSSLMODE=require
# PGSSLMODE=require

# Frontend base URL for redirects and CORS
WEBAPP_BASE_URL=http://localhost:5173

# JWT keys (prefer RS256 in production). For dev, fallback to HS256 secret below.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_SECRET=dev-insecure-secret

# SMTP (configure to send real emails; otherwise backend logs dev links)
# Common providers:
# - Mailtrap (dev): host=sandbox.smtp.mailtrap.io port=2525 secure=false
# - Office365: host=smtp.office365.com port=587 secure=false (requires modern auth/app password)
# - Gmail (app password): host=smtp.gmail.com port=465 secure=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DataInova <no-reply@data-inova.app>"

# Passwords (pepper for bcrypt/argon2id)
PASSWORD_PEPPER=

# Optional SSO/OAuth starts (front calls these to begin the flow)
# Example: GOOGLE_OAUTH_START_URL=https://accounts.google.com/o/oauth2/v2/auth?...&client_id=...&response_type=code
GOOGLE_OAUTH_START_URL=
# Example: SSO_START_URL=https://sso.your-idp.com/saml/login
SSO_START_URL=

# Embedding provider (for injection_jobs). Examples: openai, local
EMBEDDING_PROVIDER=openai

# Vector DB (pgvector)
# Local example (docker-compose):
# VECTOR_DB_URL=postgres://vector:vector@localhost:5433/vector
VECTOR_DB_URL=

# Chroma (vector DB) — recommended for dev
# Local example (docker-compose):
# CHROMA_URL=http://localhost:8000
CHROMA_URL=
